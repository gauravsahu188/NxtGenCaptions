generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  planType               PlanType  @default(FREE)
  storageLimitGb         Int       @default(1)
  transcriptionLimitMins Float     @default(5)
  maxExportRes           Int       @default(720)
  transcriptionUsedMins  Float     @default(0)
  storageUsedBytes       BigInt    @default(0)
  billingCycleStart      DateTime  @default(now())
  billingCycleEnd        DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  audioCredits           Int       @default(3)
  alphaChannelEnabled    Boolean   @default(false)
  customFontEnabled      Boolean   @default(false)
  maxVideoLengthMinutes  Int       @default(2)
  prioritySupport        Boolean   @default(false)
  srtRenderEnabled       Boolean   @default(false)
  hasUsed1RupeeTrial     Boolean   @default(false)
  hasUsed9RupeeTrial     Boolean   @default(false)
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                   String        @id @default(cuid())
  name                 String?
  email                String?       @unique
  emailVerified        DateTime?
  password             String?
  image                String?
  planType             PlanType      @default(FREE)
  transcriptionBalance Float         @default(5)
  audioCredits         Int           @default(3)
  storageUsed          BigInt        @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  accounts             Account[]
  projects             Project[]
  sessions             Session[]
  subscription         Subscription?
  transactions         Transaction[]
  apiKeys              ApiKey[]
  mcpSessions          McpSession[]
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  title     String
  metadata  Json?
  s3Url     String?
  duration  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PlanType {
  FREE
  EDITOR
  CREATOR
  BUSINESS
  TRIAL_1_INR
  TRIAL_9_INR
}

model Transaction {
  id                String   @id @default(cuid())
  userId            String
  amount            Float
  currency          String   @default("INR")
  status            String
  planType          PlanType
  razorpayOrderId   String?
  razorpayPaymentId String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  name        String    @default("Default Key")
  key         String    @unique              // The actual API key (hashed prefix + random)
  keyPrefix   String                         // First 8 chars for display (ngc_xxxx...)
  status      String    @default("active")   // active | revoked | expired
  rateLimit   Int       @default(100)        // Requests per day
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageLogs   ApiUsageLog[]
}

model ApiUsageLog {
  id          String   @id @default(cuid())
  apiKeyId    String
  tool        String                         // Which MCP tool was called
  inputTokens Int      @default(0)           // For future billing
  status      String   @default("success")   // success | error | rate_limited
  latencyMs   Int      @default(0)
  createdAt   DateTime @default(now())
  apiKey      ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
}

// Tracks an in-progress MCP caption workflow session
model McpSession {
  id           String   @id @default(cuid())
  userId       String
  s3Key        String?                        // S3 key of uploaded video
  language     String   @default("auto")
  script       String   @default("native")
  duration     Float?                         // Video duration in seconds
  captions     Json?                          // Generated caption segments
  style        Json?                          // CaptionStyleProps as JSON
  requestedRes Int?                           // Export resolution (720, 1080, etc.)
  bitrate      String?                        // Export bitrate ("auto", "4M", etc.)
  renderId     String?                        // Remotion render ID
  status       String   @default("UPLOADING") // UPLOADING | TRANSCRIBING | READY | RENDERING | DONE | ERROR
  expiresAt    DateTime                       // Sessions expire after 24h
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

{
  "name": "nxtgen-captions",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "npm run dev:all",
    "dev:sst": "sst dev",
    "dev:all": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:backend": "cd backend && npx tsx watch src/server.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "predev": "node -e \"const{execSync}=require('child_process');['3000','3001'].forEach(p=>{try{const pid=execSync('lsof -ti :'+p).toString().trim();if(pid){execSync('kill -9 '+pid);console.log('Killed process on port '+p);}}catch(e){}})\"",
    "deploy": "sst deploy --stage production",
    "build": "cd frontend && npm install && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/aws-lambda": "8.10.162",
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "sst": "4.15.2",
    "styled-components": "^6.4.1"
  }
}

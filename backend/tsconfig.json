{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "../../../video-engine/src/types": ["../video-engine/src/types"]
    }
  },
  "include": ["src/**/*"],
  "ts-node": {
    "files": true
  }
}

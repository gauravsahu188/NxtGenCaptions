# ==============================================================================
# Environment Configuration Template for nxtgencaptions.com
# Create a copy as `.env.local` on your EC2 instance:
#   cp .env.example .env.local
# ==============================================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/nxtgencaptions?schema=public"

# NextAuth / Auth.js
AUTH_SECRET="your-super-secret-random-auth-key-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://nxtgencaptions.com"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
APPLE_ID=""
APPLE_SECRET=""

# Email Service (Nodemailer / SES / Gmail)
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-app-password"
EMAIL_FROM="NxtGen Captions <noreply@nxtgencaptions.com>"

# AWS Configuration (S3, SES, SQS, Remotion Lambda)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_S3_BUCKET="nxtgen-captions-uploads"
AWS_EXPORTS_BUCKET="nxtgen-captions-exports"
AWS_SQS_QUEUE_URL="https://sqs.ap-south-1.amazonaws.com/your-account-id/nxtgen-render-queue"

# Remotion Lambda Rendering
REMOTION_REGION="ap-south-1"
REMOTION_FUNCTION_NAME="remotion-render-function"
REMOTION_SITE_URL="https://s3.ap-south-1.amazonaws.com/your-remotion-bucket/sites/CaptionVideo/index.html"

# AI Speech-to-Text & Transcription
DEEPGRAM_API_KEY="your-deepgram-api-key"
HF_TOKEN="your-huggingface-token"
SARVAM_API_KEY="your-sarvam-api-key"

# Application Ports & URLs
PORT=3001
NEXT_PUBLIC_BACKEND_URL="https://nxtgencaptions.com"

# Payment Gateways (Razorpay)
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
